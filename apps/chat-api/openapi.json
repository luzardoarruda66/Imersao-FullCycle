{
  "openapi": "3.0.0",
  "paths": {
    "/v1/sessoes": {
      "post": {
        "operationId": "SessionsController_signIn",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "senha"
                ],
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "senha": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "O membro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Membro"
                }
              }
            }
          },
          "400": {
            "description": "dados_invalidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "credenciais_invalidas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "429": {
            "description": "tentativas_demais (details.segundos_restantes)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "summary": "Entrar com e-mail e senha",
        "tags": [
          "sessoes"
        ]
      }
    },
    "/v1/sessoes/atual": {
      "delete": {
        "operationId": "SessionsController_signOut",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Sessão apagada; Set-Cookie expira o cookie"
          },
          "401": {
            "description": "sessao_invalida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "summary": "Sair: apaga a sessão do cookie",
        "tags": [
          "sessoes"
        ]
      }
    },
    "/v1/eu": {
      "get": {
        "operationId": "MeController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "O membro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Membro"
                }
              }
            }
          },
          "401": {
            "description": "sessao_invalida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "summary": "O membro da sessão",
        "tags": [
          "eu"
        ]
      }
    },
    "/v1/eu/senha": {
      "put": {
        "operationId": "MeController_changePassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "senha_atual",
                  "nova_senha"
                ],
                "properties": {
                  "senha_atual": {
                    "type": "string"
                  },
                  "nova_senha": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Senha trocada"
          },
          "400": {
            "description": "dados_invalidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "sessao_invalida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "422": {
            "description": "senha_atual_incorreta ou senha_fraca (details.regras_faltando)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "summary": "Trocar a própria senha",
        "tags": [
          "eu"
        ]
      }
    },
    "/v1/conversas": {
      "get": {
        "operationId": "ConversationsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "As conversas do membro, separadas por tipo",
        "tags": [
          "conversas"
        ]
      }
    },
    "/v1/conversas/canais": {
      "post": {
        "operationId": "ConversationsController_createChannel",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "tipo": {
                    "type": "string",
                    "enum": [
                      "publico",
                      "privado"
                    ]
                  }
                },
                "required": [
                  "nome",
                  "tipo"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Criar um canal público ou privado",
        "tags": [
          "conversas"
        ]
      }
    },
    "/v1/conversas/diretas": {
      "post": {
        "operationId": "ConversationsController_openDirect",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "membro_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  }
                },
                "required": [
                  "membro_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Abrir a conversa direta com um membro, ou devolver a que já existe",
        "tags": [
          "conversas"
        ]
      }
    },
    "/v1/conversas/{id}": {
      "get": {
        "operationId": "ConversationsController_get",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Uma conversa; o canal privado traz os participantes",
        "tags": [
          "conversas"
        ]
      }
    },
    "/v1/conversas/{id}/participantes": {
      "post": {
        "operationId": "ConversationsController_invite",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "membros_ids": {
                    "minItems": 1,
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  }
                },
                "required": [
                  "membros_ids"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Convidar membros para um canal privado",
        "tags": [
          "conversas"
        ]
      }
    },
    "/v1/conversas/{id}/mensagens": {
      "get": {
        "operationId": "ConversationsController_listMessages",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "antes",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Uma página de 50 mensagens, da mais antiga para a mais nova; `antes` pagina para trás",
        "tags": [
          "conversas"
        ]
      },
      "post": {
        "operationId": "ConversationsController_sendMessage",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "texto": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "citacao_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  }
                },
                "required": [
                  "texto"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Enviar uma mensagem",
        "tags": [
          "conversas"
        ]
      }
    },
    "/v1/conversas/{id}/mencionaveis": {
      "get": {
        "operationId": "ConversationsController_mentionable",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "busca",
            "required": false,
            "in": "query",
            "schema": {
              "default": "",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Os participantes da conversa que a pessoa pode mencionar, filtrados por nome ou @usuário",
        "tags": [
          "conversas"
        ]
      }
    },
    "/v1/conversas/{id}/leitura": {
      "post": {
        "operationId": "ConversationsController_markRead",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mensagem_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  }
                },
                "required": [
                  "mensagem_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Registrar a leitura da conversa até uma mensagem; devolve as contagens",
        "tags": [
          "conversas"
        ]
      }
    },
    "/v1/conversas/{id}/mensagens/{mensagemId}": {
      "patch": {
        "operationId": "ConversationsController_editMessage",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mensagemId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "texto": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "required": [
                  "texto"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Editar o texto da própria mensagem, até 4 horas depois do envio",
        "tags": [
          "conversas"
        ]
      }
    },
    "/v1/membros": {
      "get": {
        "operationId": "MembersController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Os membros do workspace, só id e nome",
        "tags": [
          "membros"
        ]
      }
    },
    "/v1/pessoas": {
      "get": {
        "operationId": "DirectoryController_search",
        "parameters": [
          {
            "name": "busca",
            "required": false,
            "in": "query",
            "schema": {
              "default": "",
              "type": "string"
            },
            "description": "Parte do nome ou do @usuário; vazia lista os primeiros membros"
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Buscar pessoas por parte do nome ou do @usuário",
        "tags": [
          "pessoas"
        ]
      }
    },
    "/v1/pessoas/{id}": {
      "get": {
        "operationId": "DirectoryController_profile",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "O Perfil de um membro: nome, @usuário, cargo, telefone e status",
        "tags": [
          "pessoas"
        ]
      }
    }
  },
  "info": {
    "title": "API do chat",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ErroCodigo": {
        "type": "string",
        "enum": [
          "dados_invalidos",
          "credenciais_invalidas",
          "tentativas_demais",
          "sessao_invalida",
          "senha_atual_incorreta",
          "senha_fraca",
          "origem_invalida",
          "nao_encontrado",
          "conversa_inexistente",
          "nome_canal_em_uso",
          "conversa_direta_consigo_mesmo",
          "conversa_nao_aceita_convite",
          "pessoa_inexistente",
          "mensagem_inexistente",
          "mensagem_de_outra_pessoa",
          "prazo_encerrado",
          "mensagem_apagada",
          "erro_interno"
        ]
      },
      "Erro": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErroCodigo"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            }
          }
        }
      },
      "Membro": {
        "type": "object",
        "required": [
          "id",
          "email",
          "nome",
          "administrador",
          "permissao_dados"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "administrador": {
            "type": "boolean"
          },
          "permissao_dados": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
